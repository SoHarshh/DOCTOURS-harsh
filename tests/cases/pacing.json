[
  {
    "id": "pause-saving",
    "text": "I need to save up for a few months before I can do the deposit",
    "tags": [
      "pacing",
      "pause",
      "escalate-negative"
    ],
    "expect": {
      "escalate": false,
      "shouldFollowUp": true,
      "followUpTimingIncludes": "month|week",
      "mustInclude": [
        "/check in|check back|reach out|follow up/i",
        "month|weeks",
        "/more or less time|adjust|sooner or later|different (?:time|date)|move (?:that|the) (?:reminder|check)/i"
      ],
      "mustNotInclude": [
        "https://www.doctours.com/payment",
        "checkout"
      ]
    }
  },
  {
    "id": "pause-reviewing",
